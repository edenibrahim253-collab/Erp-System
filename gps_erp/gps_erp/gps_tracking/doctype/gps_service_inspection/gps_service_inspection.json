{
 "doctype": "DocType",
 "name": "GPS Service Inspection",
 "module": "GPS Tracking",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "is_submittable": 1,
 "field_order": [
  "naming_series",
  "section_main",
  "installation",
  "vehicle",
  "serial_no",
  "column_break_main",
  "inspector",
  "inspection_date",
  "result",
  "section_findings",
  "findings",
  "non_conformance"
 ],
 "fields": [
  {"fieldname": "naming_series", "fieldtype": "Select", "label": "Series", "options": "GPS-QC-.YYYY.-.####", "reqd": 1, "default": "GPS-QC-.YYYY.-.####"},
  {"fieldname": "section_main", "fieldtype": "Section Break"},
  {"fieldname": "installation", "fieldtype": "Link", "label": "Installation", "options": "GPS Installation", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "vehicle", "fieldtype": "Link", "label": "Vehicle", "options": "GPS Vehicle", "read_only": 1, "fetch_from": "installation.vehicle", "in_list_view": 1},
  {"fieldname": "serial_no", "fieldtype": "Link", "label": "Device (Serial No / IMEI)", "options": "Serial No", "read_only": 1, "fetch_from": "installation.serial_no"},
  {"fieldname": "column_break_main", "fieldtype": "Column Break"},
  {"fieldname": "inspector", "fieldtype": "Link", "label": "Inspector", "options": "Employee", "in_standard_filter": 1},
  {"fieldname": "inspection_date", "fieldtype": "Date", "label": "Inspection Date", "default": "Today", "reqd": 1, "in_list_view": 1},
  {"fieldname": "result", "fieldtype": "Select", "label": "Result", "options": "Pass\nFail", "default": "Pass", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "section_findings", "fieldtype": "Section Break", "label": "Findings"},
  {"fieldname": "findings", "fieldtype": "Small Text", "label": "Findings"},
  {"fieldname": "non_conformance", "fieldtype": "Link", "label": "Non Conformance", "options": "Non Conformance", "read_only": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1, "export": 1, "print": 1, "report": 1},
  {"role": "GPS Fleet Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1, "export": 1, "print": 1, "report": 1},
  {"role": "GPS Technician", "read": 1},
  {"role": "GPS Support Agent", "read": 1},
  {"role": "GPS Finance", "read": 1}
 ],
 "sort_field": "inspection_date",
 "sort_order": "DESC",
 "track_changes": 1,
 "engine": "InnoDB"
}
