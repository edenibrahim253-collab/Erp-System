{
 "doctype": "DocType",
 "name": "GPS Installation",
 "module": "GPS Tracking",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "is_submittable": 1,
 "field_order": [
  "naming_series",
  "section_scope",
  "vehicle",
  "customer",
  "serial_no",
  "sim_card",
  "column_break_scope",
  "technician",
  "scheduled_date",
  "installation_date",
  "status",
  "section_checklist",
  "checklist",
  "section_evidence",
  "photo",
  "signature",
  "column_break_evidence",
  "platform_device_id",
  "platform_verified",
  "section_notes",
  "notes"
 ],
 "fields": [
  {"fieldname": "naming_series", "fieldtype": "Select", "label": "Series", "options": "GPS-INST-.YYYY.-.####", "reqd": 1, "default": "GPS-INST-.YYYY.-.####"},
  {"fieldname": "section_scope", "fieldtype": "Section Break"},
  {"fieldname": "vehicle", "fieldtype": "Link", "label": "Vehicle", "options": "GPS Vehicle", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "customer", "fieldtype": "Link", "label": "Customer", "options": "Customer", "read_only": 1, "fetch_from": "vehicle.customer", "in_standard_filter": 1},
  {"fieldname": "serial_no", "fieldtype": "Link", "label": "Device (Serial No / IMEI)", "options": "Serial No", "reqd": 1, "in_list_view": 1},
  {"fieldname": "sim_card", "fieldtype": "Link", "label": "SIM Card", "options": "GPS SIM Card", "in_list_view": 1},
  {"fieldname": "column_break_scope", "fieldtype": "Column Break"},
  {"fieldname": "technician", "fieldtype": "Link", "label": "Technician", "options": "Employee", "in_standard_filter": 1},
  {"fieldname": "scheduled_date", "fieldtype": "Date", "label": "Scheduled Date"},
  {"fieldname": "installation_date", "fieldtype": "Date", "label": "Installation Date", "default": "Today", "in_list_view": 1},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Pending\nIn Progress\nInstalled\nAwaiting QC\nQC Passed\nQC Failed\nClosed", "default": "Pending", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "section_checklist", "fieldtype": "Section Break", "label": "Installation Checklist"},
  {"fieldname": "checklist", "fieldtype": "Table", "label": "Checklist", "options": "GPS Checklist Item"},
  {"fieldname": "section_evidence", "fieldtype": "Section Break", "label": "Evidence & Platform Activation"},
  {"fieldname": "photo", "fieldtype": "Attach Image", "label": "Installation Photo"},
  {"fieldname": "signature", "fieldtype": "Signature", "label": "Customer Signature"},
  {"fieldname": "column_break_evidence", "fieldtype": "Column Break"},
  {"fieldname": "platform_device_id", "fieldtype": "Data", "label": "Platform Device ID"},
  {"fieldname": "platform_verified", "fieldtype": "Check", "label": "Verified Active on GPS Platform"},
  {"fieldname": "section_notes", "fieldtype": "Section Break", "label": "Notes"},
  {"fieldname": "notes", "fieldtype": "Long Text", "label": "Notes"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1, "export": 1, "print": 1, "report": 1},
  {"role": "GPS Fleet Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1, "export": 1, "print": 1, "report": 1},
  {"role": "GPS Technician", "read": 1, "write": 1, "create": 1, "submit": 1, "export": 1, "print": 1},
  {"role": "GPS Support Agent", "read": 1},
  {"role": "GPS Finance", "read": 1, "report": 1, "export": 1}
 ],
 "search_fields": "vehicle,serial_no,sim_card",
 "sort_field": "installation_date",
 "sort_order": "DESC",
 "title_field": "vehicle",
 "track_changes": 1,
 "engine": "InnoDB"
}
